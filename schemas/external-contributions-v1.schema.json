{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dasomel/openforge/schemas/external-contributions-v1.schema.json",
  "title": "OpenForge External Contributions v1",
  "description": "Registry of public discussions and contributions by external (non-owner, non-bot) GitHub accounts across portfolio repositories. GitHub handles only; state is a snapshot as of observed_at.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observed_at", "entries"],
  "properties": {
    "schema_version": {"const": "openforge-external-contributions/v1"},
    "observed_at": {"$ref": "#/$defs/datetime"},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "datetime": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "handle": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$"},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "kind", "number", "url", "contributors", "contribution_type", "summary", "state", "observed_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "kind": {"enum": ["issue", "pull_request"]},
        "number": {"type": "integer", "minimum": 1},
        "url": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/(?:issues|pull)/[0-9]+$"},
        "contributors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/handle"}},
        "contribution_type": {"enum": ["design", "proposal", "design-review", "support-offer", "bug-report", "docs"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 240},
        "state": {"enum": ["open", "closed", "merged"]},
        "outcome": {"type": "string", "minLength": 1, "maxLength": 240},
        "observed_at": {"$ref": "#/$defs/datetime"}
      }
    }
  }
}
