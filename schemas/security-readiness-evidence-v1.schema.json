{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dasomel/openforge/schemas/security-readiness-evidence-v1.schema.json",
  "title": "OpenForge Security Readiness Evidence v1",
  "description": "Tool-neutral, per-repository record of observed security/supply-chain signals. Upstream tools remain the source of the underlying checks; this is not a compliance or certification claim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "revision", "observed_at", "signals", "summary", "disclaimer"],
  "properties": {
    "schema_version": {"const": "openforge-security-readiness-evidence/v1"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "observed_at": {"$ref": "#/$defs/datetime"},
    "signals": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/signal"}},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "pass", "fail", "partial", "not_run", "not_applicable"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "pass": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "partial": {"type": "integer", "minimum": 0},
        "not_run": {"type": "integer", "minimum": 0},
        "not_applicable": {"type": "integer", "minimum": 0}
      }
    },
    "disclaimer": {"const": "Upstream tools remain the source of the underlying checks; OpenForge only normalizes the evidence. This record is not a compliance or certification claim."}
  },
  "$defs": {
    "datetime": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "source"],
      "properties": {
        "id": {"enum": ["scorecard", "security-policy", "actions-pinning", "sbom", "provenance", "release-signing"]},
        "status": {"enum": ["pass", "fail", "partial", "not-run", "not-applicable"]},
        "note": {"type": "string", "minLength": 1},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "observed_at", "ref"],
          "properties": {
            "tool": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "observed_at": {"$ref": "#/$defs/datetime"},
            "ref": {"type": "string", "minLength": 1}
          }
        },
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "remediation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": {"enum": ["not-started", "planned", "in-progress", "done", "wont-fix"]},
            "issue_or_pr": {"type": "string", "minLength": 1}
          }
        },
        "exceptions": {"type": "array", "items": {"$ref": "#/$defs/exception"}},
        "rescan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["previous_ref", "previous_observed_at", "delta"],
          "properties": {
            "previous_ref": {"type": "string", "minLength": 1},
            "previous_observed_at": {"$ref": "#/$defs/datetime"},
            "delta": {"enum": ["improved", "unchanged", "regressed"]},
            "finding_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "resolved_findings": {"type": "array", "items": {"$ref": "#/$defs/resolved_finding"}}
          }
        }
      }
    },
    "resolved_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary", "resolved_by"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "resolved_by": {"type": "string", "minLength": 1}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary", "severity"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "severity": {"enum": ["info", "low", "medium", "high", "critical"]}
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "rationale", "expires"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "expires": {"$ref": "#/$defs/date"},
        "review_date": {"$ref": "#/$defs/date"},
        "finding_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
