{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dasomel/openforge/schemas/legacy-evidence-catalog-v1.schema.json",
  "title": "OpenForge Legacy Evidence Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entries",
    "pending_repositories"
  ],
  "properties": {
    "schema_version": {
      "const": "openforge-legacy-evidence-catalog/v1"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "pending_repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "status",
          "reason"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "status": {
            "const": "not-scanned"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "path",
        "evidence_date",
        "evidence_class",
        "evidence_strength",
        "environment_scope",
        "metrics_or_facts",
        "limitations",
        "future_paper_use",
        "privacy_review",
        "availability"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "evidence_date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^$|^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
        },
        "evidence_class": {
          "enum": [
            "verification-quality",
            "deployment-reproducibility",
            "reliability-recovery",
            "runtime-performance",
            "agent-assisted-engineering",
            "release-adoption-evolution",
            "architecture-requirements"
          ]
        },
        "evidence_strength": {
          "enum": [
            "measured",
            "observed",
            "derived",
            "contextual"
          ]
        },
        "environment_scope": {
          "enum": [
            "local-test",
            "ci",
            "simulation",
            "live-test",
            "unknown"
          ]
        },
        "metrics_or_facts": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        },
        "future_paper_use": {
          "type": "string",
          "minLength": 1
        },
        "privacy_review": {
          "enum": [
            "public-ok",
            "secret-check-required",
            "exclude"
          ]
        },
        "availability": {
          "description": "Whether the artifact is reachable from a clone: tracked in git, present only in the scanned working tree, or indeterminate because that root is not a git repository.",
          "enum": [
            "committed",
            "local-only",
            "unknown"
          ]
        }
      }
    }
  }
}
