#!/usr/bin/env bash
set -euo pipefail

fixture_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

args=()
while (($#)); do
  case "$1" in
    --context|-n|--namespace)
      shift 2
      ;;
    -A|--all-namespaces)
      shift
      ;;
    -o|--output)
      shift 2
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

key="${args[*]}"
case "$key" in
  "get --raw /metrics")
    cat "$fixture_dir/metrics.txt"
    ;;
  "get clusterrolebindings")
    cat "$fixture_dir/clusterrolebindings.json"
    ;;
  "get clusterroles")
    cat "$fixture_dir/clusterroles.json"
    ;;
  "get deployments,statefulsets,daemonsets")
    cat "$fixture_dir/workloads.json"
    ;;
  *)
    echo "runtime security fixture does not provide: kubectl $key" >&2
    exit 1
    ;;
esac
