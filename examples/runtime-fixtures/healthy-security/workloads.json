{
  "apiVersion": "v1",
  "items": [
    {
      "kind": "Deployment",
      "metadata": {"namespace": "platform", "name": "api"},
      "spec": {
        "template": {
          "spec": {
            "containers": [
              {
                "name": "api",
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "runAsNonRoot": true,
                  "runAsUser": 10001,
                  "capabilities": {"drop": ["ALL"]}
                }
              }
            ]
          }
        }
      }
    }
  ]
}
