{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {"namespace": "platform", "name": "api"},
      "spec": {
        "replicas": 2,
        "template": {
          "metadata": {"labels": {"app": "api"}},
          "spec": {
            "containers": [
              {
                "name": "api",
                "image": "example.invalid/api:v1",
                "readinessProbe": {"httpGet": {"path": "/ready", "port": 8080}},
                "livenessProbe": {"httpGet": {"path": "/health", "port": 8080}},
                "resources": {
                  "requests": {"cpu": "100m", "memory": "128Mi"},
                  "limits": {"cpu": "500m", "memory": "512Mi"}
                }
              }
            ]
          }
        }
      },
      "status": {"availableReplicas": 2}
    },
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {"namespace": "platform", "name": "database"},
      "spec": {
        "replicas": 2,
        "template": {
          "metadata": {"labels": {"app": "database"}},
          "spec": {
            "containers": [
              {
                "name": "database",
                "image": "example.invalid/database:v1",
                "startupProbe": {"tcpSocket": {"port": 5432}},
                "resources": {
                  "requests": {"cpu": "250m", "memory": "512Mi"},
                  "limits": {"cpu": "1", "memory": "1Gi"}
                }
              }
            ]
          }
        }
      },
      "status": {"readyReplicas": 2}
    },
    {
      "apiVersion": "apps/v1",
      "kind": "DaemonSet",
      "metadata": {"namespace": "platform", "name": "node-agent"},
      "spec": {
        "template": {
          "metadata": {"labels": {"app": "node-agent"}},
          "spec": {
            "containers": [
              {
                "name": "agent",
                "image": "example.invalid/agent:v1",
                "livenessProbe": {"exec": {"command": ["/bin/check"]}},
                "resources": {
                  "requests": {"cpu": "50m", "memory": "64Mi"},
                  "limits": {"cpu": "200m", "memory": "256Mi"}
                }
              }
            ]
          }
        }
      },
      "status": {"desiredNumberScheduled": 2, "numberAvailable": 2}
    }
  ]
}
