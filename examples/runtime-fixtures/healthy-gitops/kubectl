#!/usr/bin/env bash
set -euo pipefail
fixture_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
args=()
while (($#)); do
  case "$1" in
    --context|-n|--namespace)
      shift 2
      ;;
    -A|--all-namespaces)
      shift
      ;;
    -o|--output)
      shift 2
      ;;
    *) args+=("$1"); shift ;;
  esac
done
key="${args[*]}"
case "$key" in
  "get applications.argoproj.io") cat "$fixture_dir/applications.json" ;;
  "get kustomizations.kustomize.toolkit.fluxcd.io") cat "$fixture_dir/kustomizations.json" ;;
  "get helmreleases.helm.toolkit.fluxcd.io") cat "$fixture_dir/helmreleases.json" ;;
  *) echo "runtime GitOps fixture does not provide: kubectl $key" >&2; exit 1 ;;
esac
